APP_NAME="Portfolio API"
APP_ENVIRONMENT=development

# Local development only. Used by both the API and Docker Compose.
APP_DB_HOST=127.0.0.1
APP_DB_PORT=5432
APP_DB_NAME=portfolio
APP_DB_USER=portfolio
APP_DB_PASSWORD=local-development-password

# Required: generate with python -c 'import secrets; print(secrets.token_hex(32))'
APP_JWT_SECRET=
APP_JWT_ISSUER=portfolio-api
APP_JWT_AUDIENCE=portfolio-api
APP_ACCESS_TOKEN_MINUTES=15
